{
  "name": "minecraft-local-server-app",
  "version": "1.9.1",
  "description": "Minecraft Local Server Manager",
  "author": "FixItNow",
  "homepage": "https://github.com/hugoaldaHD/minecraft-local-server-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugoaldaHD/minecraft-local-server-app.git"
  },
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64",
    "build:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "build:ci": "npm run build:win",
    "build:win": "electron-builder --win --x64 --publish always",
    "build:linux": "electron-builder --linux AppImage deb --x64 --publish always",
    "release": "node scripts/release.mjs",
    "release:notes": "node scripts/release.mjs --backfill"
  },
  "build": {
    "appId": "com.minecraftmanager.app",
    "productName": "Minecraft Local Server Manager",
    "artifactName": "${productName}.${ext}",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Minecraft Manager",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "synopsis": "Gestor de servidores locales de Minecraft",
      "desktop": {
        "Name": "Minecraft Manager",
        "StartupWMClass": "minecraft-local-server-manager"
      }
    },
    "deb": {
      "maintainer": "FixItNow <hugoaldaHD@users.noreply.github.com>",
      "priority": "optional",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libasound2 | libasound2t64",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libsecret-1-0",
        "libuuid1",
        "xdg-utils"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/index.js",
      "main/*.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.4",
    "node-schedule": "^2.1.1",
    "systeminformation": "^5.22.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9"
  }
}
